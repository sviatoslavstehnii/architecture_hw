<?xml version="1.0" encoding="UTF-8"?>
<hazelcast
    xmlns="http://www.hazelcast.com/schema/config"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.hazelcast.com/schema/config
        http://www.hazelcast.com/schema/config/hazelcast-config-5.1.xsd">

    <!-- cluster name -->
    <cluster-name>messaging-cluster</cluster-name>

    <network>
        <join>
            <multicast enabled="false"/>
            <tcp-ip enabled="true">
                <member>127.0.0.1:5801</member>
                <member>127.0.0.1:5802</member>
            </tcp-ip>
        </join>
    </network>

    <!-- define your distributed queue -->
    <queue name="messages-queue">
        <backup-count>1</backup-count>
    </queue>
</hazelcast>
